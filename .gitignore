# GitHub rechaza archivos >100 MB y limita repositorios a 2 GB.
/GRAMATICA/
/ENTRENAMIENTO JLPT/
/ESCRITURA/
/MANUALES INDEPENDIENTES/
/VOCABULARIO/
*.mp3
*.pdf

# Logs del sistema y editores
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

